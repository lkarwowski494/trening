{
  "name": "trening",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:i18n": "node scripts/check-i18n.mjs",
    "test": "jest",
    "verify:native": "node scripts/verify-native.mjs",
    "check:matrix": "node scripts/test-matrix.mjs --check",
    "check:pokrycie": "node scripts/pokrycie-katalogu.mjs --check",
    "check:licenses": "node scripts/licenses.mjs --check",
    "check:cues": "node scripts/cues/gen.mjs --check",
    "check:claims": "node scripts/claims.mjs --check",
    "check:decyzje": "node scripts/decyzje.mjs --check",
    "check:figures": "node scripts/figures/gen.mjs --check",
    "check:figures-v2": "node scripts/figures/v2-gen.mjs --check && node scripts/figures/v2-validate.mjs --schema --check",
    "check:zrodla-runtime": "node scripts/zrodla-runtime.mjs --check",
    "check:bundle": "node scripts/check-bundle.mjs .expo/verify-export",
    "check:release": "node scripts/ci/blokada-wydania.mjs",
    "check:readme": "node scripts/readme.mjs --check",
    "check:pochodne": "node scripts/pochodne.mjs",
    "check:slowniki": "node scripts/slowniki.mjs",
    "verify": "node scripts/hooks/sprawdz-instalacje.mjs && npm run typecheck && npm run lint && npm run check:i18n && npm run check:cues && npm run check:claims && npm run check:decyzje && npm run check:figures && npm run check:figures-v2 && npm run check:zrodla-runtime && npm run check:pokrycie && npm run check:readme && jest && npm run check:matrix && npm run check:licenses && npx expo export --platform ios --output-dir .expo/verify-export && npm run check:bundle && node -e \"require('fs').rmSync('.expo/verify-export',{recursive:true,force:true})\" && npm run verify:native && node scripts/verify-znacznik.mjs --zapisz pelne",
    "screens": "node scripts/screens/run.mjs",
    "mutation": "stryker run",
    "perf": "jest -c jest.perf.config.js",
    "test:fast": "node scripts/test-fast.mjs",
    "verify:docs": "node scripts/verify-docs.mjs",
    "prepare": "node scripts/hooks/instaluj.mjs"
  },
  "dependencies": {
    "@bacons/apple-targets": "^5.0.0",
    "@kingstinct/react-native-healthkit": "^16.1.0",
    "expo": "~57.0.26",
    "expo-asset": "~57.0.18",
    "expo-constants": "~57.0.20",
    "expo-crypto": "~57.0.3",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-iap": "5.8.1",
    "expo-keep-awake": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-localization": "~57.0.2",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.24",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-store-review": "~57.0.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@expo-google-fonts/ibm-plex-mono": "^0.4.1",
    "@expo-google-fonts/ibm-plex-sans": "^0.4.1",
    "@expo/metro-runtime": "~57.0.16",
    "@stryker-mutator/core": "^8.7.1",
    "@stryker-mutator/jest-runner": "^8.7.1",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.10",
    "babel-preset-expo": "~57.0.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "fast-check": "^3.23.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "js-yaml": "3.15.2",
    "react-dom": "19.2.3",
    "react-native-web": "^0.21.0",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "private": true,
  "expo": {
    "autolinking": {
      "exclude": [
        "@bacons/apple-targets"
      ]
    }
  },
  "jest": {
    "preset": "jest-expo/ios",
    "setupFiles": [
      "<rootDir>/tests/setup.js"
    ],
    "testMatch": [
      "<rootDir>/tests/**/*.test.[jt]s?(x)"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|standard-navigation)"
    ],
    "globalSetup": "<rootDir>/tests/global-setup.js",
    "modulePathIgnorePatterns": [
      "<rootDir>/.stryker-tmp",
      "<rootDir>/.claude/worktrees"
    ],
    "workerIdleMemoryLimit": "1500MB"
  }
}
