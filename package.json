{
  "name": "trening",
  "version": "1.0.1",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:i18n": "node scripts/check-i18n.mjs",
    "test": "jest",
    "verify:native": "node scripts/verify-native.mjs",
    "verify:kontrole": "node scripts/ci/kontrole.mjs",
    "check:matrix": "node scripts/test-matrix.mjs --check",
    "check:pokrycie": "node scripts/pokrycie-katalogu.mjs --check",
    "check:licenses": "node scripts/licenses.mjs --check",
    "check:cues": "node scripts/cues/gen.mjs --check",
    "check:claims": "node scripts/claims.mjs --check",
    "check:decyzje": "node scripts/decyzje.mjs --check",
    "check:figures": "node scripts/figures/gen.mjs --check",
    "check:figures-v2": "node scripts/figures/v2-gen.mjs --check && node scripts/figures/v2-validate.mjs --schema --check",
    "check:zrodla-runtime": "node scripts/zrodla-runtime.mjs --check",
    "check:bundle": "node scripts/check-bundle.mjs .expo/verify-export",
    "check:release": "node scripts/ci/blokada-wydania.mjs",
    "check:readme": "node scripts/readme.mjs --check",
    "check:pochodne": "node scripts/pochodne.mjs",
    "check:znaczniki": "node scripts/check-znaczniki-konfliktu.mjs",
    "check:slowniki": "node scripts/slowniki.mjs",
    "verify": "node scripts/hooks/sprawdz-instalacje.mjs && node scripts/verify-znacznik.mjs --czysta && npm run typecheck && npm run lint && npm run check:i18n && npm run check:cues && npm run check:claims && npm run check:decyzje && npm run check:figures && npm run check:figures-v2 && npm run check:zrodla-runtime && npm run check:pokrycie && npm run check:readme && npm run check:znaczniki && node scripts/jest-ponow.mjs && npm run check:matrix && npm run check:licenses && npx expo export --platform ios --output-dir .expo/verify-export && npm run check:bundle && node -e \"require('fs').rmSync('.expo/verify-export',{recursive:true,force:true})\" && npm run verify:native && node scripts/verify-znacznik.mjs --zapisz pelne",
    "screens": "node scripts/screens/run.mjs",
    "mutation": "stryker run",
    "perf": "jest -c jest.perf.config.js",
    "verify:szybkie": "node scripts/hooks/sprawdz-instalacje.mjs && node scripts/verify-znacznik.mjs --czysta && node scripts/sprawdz-dysk.mjs && npm run typecheck && npm run lint && npm run check:i18n && npm run check:cues && npm run check:claims && npm run check:decyzje && npm run check:figures && npm run check:figures-v2 && npm run check:zrodla-runtime && npm run check:pokrycie && npm run check:readme && npm run check:znaczniki && npm run check:matrix && npm run check:licenses && node scripts/test-fast.mjs --od-bazy && node scripts/verify-znacznik.mjs --zapisz szybkie",
    "verify:lekkie": "node scripts/hooks/sprawdz-instalacje.mjs && node scripts/verify-znacznik.mjs --czysta && node scripts/sprawdz-dysk.mjs && npm run typecheck && npm run lint && npm run check:i18n && npm run check:cues && npm run check:claims && npm run check:decyzje && npm run check:figures && npm run check:figures-v2 && npm run check:zrodla-runtime && npm run check:pokrycie && npm run check:readme && npm run check:znaczniki && npm run check:matrix && npm run check:licenses && node scripts/verify-znacznik.mjs --zapisz lekkie",
    "test:fast": "node scripts/test-fast.mjs",
    "verify:docs": "node scripts/verify-docs.mjs",
    "prepare": "node scripts/hooks/instaluj.mjs"
  },
  "dependencies": {
    "@bacons/apple-targets": "^5.0.0",
    "@kingstinct/react-native-healthkit": "^16.1.0",
    "expo": "~58.0.22",
    "expo-asset": "~58.0.19",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-iap": "5.8.1",
    "expo-keep-awake": "~58.0.3",
    "expo-linking": "~58.0.15",
    "expo-localization": "~58.0.5",
    "expo-notifications": "~58.1.7",
    "expo-router": "~58.0.29",
    "expo-sharing": "~58.0.21",
    "expo-splash-screen": "~58.0.12",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "expo-store-review": "~58.0.2",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@expo-google-fonts/ibm-plex-mono": "^0.4.1",
    "@expo-google-fonts/ibm-plex-sans": "^0.4.1",
    "@expo/metro-runtime": "~58.0.16",
    "@stryker-mutator/core": "^8.7.1",
    "@stryker-mutator/jest-runner": "^8.7.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "fast-check": "^3.23.2",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.13",
    "js-yaml": "3.15.2",
    "react-dom": "19.3.0",
    "react-native-web": "^0.21.4",
    "react-test-renderer": "19.3.0",
    "typescript": "~6.0.3"
  },
  "private": true,
  "expo": {
    "autolinking": {
      "exclude": [
        "@bacons/apple-targets"
      ]
    }
  },
  "jest": {
    "preset": "jest-expo/ios",
    "setupFiles": [
      "<rootDir>/tests/setup.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup-limity-czasu.js"
    ],
    "testMatch": [
      "<rootDir>/tests/**/*.test.[jt]s?(x)"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|standard-navigation)"
    ],
    "globalSetup": "<rootDir>/tests/global-setup.js",
    "modulePathIgnorePatterns": [
      "<rootDir>/.stryker-tmp",
      "<rootDir>/.claude/worktrees"
    ],
    "workerIdleMemoryLimit": "1500MB"
  }
}
