{
  "name": "trening",
  "version": "0.9.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "check:i18n": "node scripts/check-i18n.mjs",
    "test": "jest",
    "verify:native": "node scripts/verify-native.mjs",
    "verify": "npm run typecheck && npm run check:i18n && jest && npx expo export --platform ios --output-dir .expo/verify-export && node -e \"require('fs').rmSync('.expo/verify-export',{recursive:true,force:true})\" && npm run verify:native",
    "screens": "node scripts/screens/run.mjs",
    "mutation": "stryker run",
    "perf": "jest -c jest.perf.config.js"
  },
  "dependencies": {
    "@bacons/apple-targets": "^4.0.7",
    "@kingstinct/react-native-healthkit": "^8.7.2",
    "@react-navigation/native": "^7.0.0",
    "expo": "~53.0.27",
    "expo-asset": "~11.1.7",
    "expo-constants": "~17.1.8",
    "expo-crypto": "~14.1.5",
    "expo-document-picker": "~13.1.6",
    "expo-file-system": "~18.1.11",
    "expo-font": "~13.3.2",
    "expo-haptics": "~14.1.4",
    "expo-keep-awake": "~14.1.4",
    "expo-linking": "~7.1.7",
    "expo-localization": "~16.1.6",
    "expo-notifications": "~0.31.5",
    "expo-router": "~5.1.11",
    "expo-sharing": "~13.1.5",
    "expo-sqlite": "~15.2.14",
    "expo-status-bar": "~2.2.3",
    "query-string": "^7.1.3",
    "react": "19.0.0",
    "react-native": "0.79.6",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-svg": "15.11.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@expo/metro-runtime": "~5.0.5",
    "@stryker-mutator/core": "^8.7.1",
    "@stryker-mutator/jest-runner": "^8.7.1",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.0.10",
    "fast-check": "^3.23.2",
    "jest": "^29.7.0",
    "jest-expo": "~53.0.14",
    "react-dom": "19.0.0",
    "react-native-web": "^0.20.0",
    "react-test-renderer": "19.0.0",
    "typescript": "~5.8.3"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo/ios",
    "setupFiles": [
      "<rootDir>/tests/setup.js"
    ],
    "testMatch": [
      "<rootDir>/tests/**/*.test.[jt]s?(x)"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg)"
    ],
    "globalSetup": "<rootDir>/tests/global-setup.js"
  }
}
