{
  "name": "trening",
  "version": "0.9.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "check:i18n": "node scripts/check-i18n.mjs",
    "test": "jest",
    "verify:native": "node scripts/verify-native.mjs",
    "verify": "npm run typecheck && npm run check:i18n && jest && npx expo export --platform ios --output-dir .expo/verify-export && node -e \"require('fs').rmSync('.expo/verify-export',{recursive:true,force:true})\" && npm run verify:native",
    "screens": "node scripts/screens/run.mjs",
    "mutation": "stryker run",
    "perf": "jest -c jest.perf.config.js"
  },
  "dependencies": {
    "@bacons/apple-targets": "^4.0.7",
    "@expo/prebuild-config": "~54.0.9",
    "@kingstinct/react-native-healthkit": "^8.7.2",
    "@react-navigation/native": "^7.0.0",
    "expo": "~54.0.37",
    "expo-asset": "~12.0.13",
    "expo-constants": "~18.0.14",
    "expo-crypto": "~15.0.9",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-keep-awake": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-localization": "~17.0.9",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-sharing": "~14.0.8",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "query-string": "^7.1.3",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@expo/metro-runtime": "~6.1.2",
    "@stryker-mutator/core": "^8.7.1",
    "@stryker-mutator/jest-runner": "^8.7.1",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.10",
    "fast-check": "^3.23.2",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.18",
    "react-dom": "19.1.0",
    "react-native-web": "^0.21.0",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo/ios",
    "setupFiles": [
      "<rootDir>/tests/setup.js"
    ],
    "testMatch": [
      "<rootDir>/tests/**/*.test.[jt]s?(x)"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg)"
    ],
    "globalSetup": "<rootDir>/tests/global-setup.js"
  }
}
