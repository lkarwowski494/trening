{
  "name": "trening",
  "version": "0.8.5",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "check:i18n": "node scripts/check-i18n.mjs",
    "test": "jest",
    "verify:native": "node scripts/verify-native.mjs",
    "verify": "npm run typecheck && npm run check:i18n && jest && npx expo export --platform ios --output-dir .expo/verify-export && node -e \"require('fs').rmSync('.expo/verify-export',{recursive:true,force:true})\" && npm run verify:native",
    "screens": "node scripts/screens/run.mjs",
    "mutation": "stryker run",
    "perf": "jest -c jest.perf.config.js"
  },
  "dependencies": {
    "@bacons/apple-targets": "^4.0.7",
    "@kingstinct/react-native-healthkit": "^8.7.2",
    "@react-navigation/native": "^7.0.0",
    "expo": "~52.0.0",
    "expo-asset": "~11.0.5",
    "expo-constants": "~17.0.0",
    "expo-crypto": "~14.0.2",
    "expo-document-picker": "~13.0.0",
    "expo-file-system": "~18.0.0",
    "expo-font": "~13.0.4",
    "expo-haptics": "~14.0.0",
    "expo-keep-awake": "~14.0.0",
    "expo-linking": "~7.0.0",
    "expo-localization": "~16.0.1",
    "expo-notifications": "~0.29.0",
    "expo-router": "~4.0.0",
    "expo-sharing": "~13.0.0",
    "expo-sqlite": "~15.1.0",
    "expo-status-bar": "~2.0.0",
    "query-string": "^7.1.3",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@expo/metro-runtime": "~4.0.1",
    "@stryker-mutator/core": "^8.7.1",
    "@stryker-mutator/jest-runner": "^8.7.1",
    "@testing-library/react-native": "^12.9.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~18.3.12",
    "fast-check": "^3.23.2",
    "jest": "^29.7.0",
    "jest-expo": "~52.0.6",
    "react-dom": "^18.3.1",
    "react-native-web": "^0.19.13",
    "react-test-renderer": "^18.3.1",
    "typescript": "^5.3.3"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo/ios",
    "setupFiles": [
      "<rootDir>/tests/setup.js"
    ],
    "testMatch": [
      "<rootDir>/tests/**/*.test.[jt]s?(x)"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg)"
    ]
  }
}
