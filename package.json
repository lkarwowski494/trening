{
  "name": "trening",
  "version": "0.9.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "check:i18n": "node scripts/check-i18n.mjs",
    "test": "jest",
    "verify:native": "node scripts/verify-native.mjs",
    "verify": "npm run typecheck && npm run check:i18n && jest && npx expo export --platform ios --output-dir .expo/verify-export && node -e \"require('fs').rmSync('.expo/verify-export',{recursive:true,force:true})\" && npm run verify:native",
    "screens": "node scripts/screens/run.mjs",
    "mutation": "stryker run",
    "perf": "jest -c jest.perf.config.js"
  },
  "dependencies": {
    "@bacons/apple-targets": "^4.0.7",
    "@expo/prebuild-config": "~56.0.0",
    "@kingstinct/react-native-healthkit": "^8.7.2",
    "expo": "~56.0.23",
    "expo-asset": "~56.0.25",
    "expo-constants": "~56.0.27",
    "expo-crypto": "~56.0.5",
    "expo-document-picker": "~56.0.4",
    "expo-file-system": "~56.0.11",
    "expo-font": "~56.0.7",
    "expo-haptics": "~56.0.3",
    "expo-keep-awake": "~56.0.3",
    "expo-linking": "~56.0.18",
    "expo-localization": "~56.0.6",
    "expo-notifications": "~56.0.26",
    "expo-router": "~56.2.21",
    "expo-sharing": "~56.0.26",
    "expo-splash-screen": "~56.0.15",
    "expo-sqlite": "~56.0.6",
    "expo-status-bar": "~56.0.4",
    "query-string": "^7.1.3",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.8.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@expo/metro-runtime": "~56.0.21",
    "@stryker-mutator/core": "^8.7.1",
    "@stryker-mutator/jest-runner": "^8.7.1",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.10",
    "babel-preset-expo": "~56.0.0",
    "fast-check": "^3.23.2",
    "jest": "^29.7.0",
    "jest-expo": "~56.0.5",
    "react-dom": "19.2.3",
    "react-native-web": "^0.21.0",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo/ios",
    "setupFiles": [
      "<rootDir>/tests/setup.js"
    ],
    "testMatch": [
      "<rootDir>/tests/**/*.test.[jt]s?(x)"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|standard-navigation)"
    ],
    "globalSetup": "<rootDir>/tests/global-setup.js"
  }
}
