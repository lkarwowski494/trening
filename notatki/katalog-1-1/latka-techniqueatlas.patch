diff --git a/tests/kontrakt.test.mjs b/tests/kontrakt.test.mjs
new file mode 100644
index 0000000..0838ebc
--- /dev/null
+++ b/tests/kontrakt.test.mjs
@@ -0,0 +1,28 @@
+// Kontrakt pól eksportu aplikacji (scripts/strona/kontrakt.json w repo aplikacji) sprawdzany na PRAWDZIWYCH danych z .cache/dane — nie na obiektach napisanych w teście.
+// Aplikacja eksportuje kontrakt i walidator razem z danymi (manifest.contract); brak = PIN.json wskazuje commit sprzed kontraktu (podnieś PIN).
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync, existsSync } from 'node:fs';
+import { join } from 'node:path';
+import { pathToFileURL } from 'node:url';
+import { CACHE, readJson } from '../src/lib.mjs';
+import { requireData } from './pomoc.mjs';
+
+requireData();
+const dane = join(CACHE, 'dane'), man = readJson('.cache/dane/manifest.json');
+test('manifest wskazuje kontrakt i walidator (commit z PIN.json ma kontrakt pól eksportu)', () => {
+  assert.ok(man.contract, 'manifest bez contract — PIN.json wskazuje commit aplikacji sprzed kontraktu pól');
+  for (const f of [man.contract.schema, man.contract.validator]) assert.ok(existsSync(join(dane, f)), f);
+});
+test('każdy zbudowany plik języka z eksportu spełnia kontrakt (role {id, text}, id ma etykietę regionu)', async () => {
+  const { waliduj } = await import(pathToFileURL(join(dane, man.contract.validator)).href);
+  const schema = JSON.parse(readFileSync(join(dane, man.contract.schema), 'utf8')).plik;
+  for (const x of man.languages) assert.deepEqual(waliduj(schema, JSON.parse(readFileSync(join(dane, x.file), 'utf8'))).slice(0, 3), [], x.lang);
+});
+test('brak przekładu = brak zdania: licznik braków w manifeście zgadza się z plikami języków', () => {
+  for (const x of man.languages) {
+    const d = JSON.parse(readFileSync(join(dane, x.file), 'utf8'));
+    assert.equal(x.missing.cues, d.meta.cuesWithoutText, x.lang);
+    assert.deepEqual(x.missing.exercises, Object.fromEntries(d.exercises.filter(e => e.cues.missing).map(e => [e.slug, e.cues.missing])), x.lang);
+  }
+});
