{
  "permissions": {
    "allow": [
      "Bash(npm run:*)",
      "Bash(npx jest:*)",
      "Bash(node scripts/:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git merge:*)",
      "Bash(git fetch:*)",
      "Bash(git branch:*)",
      "Bash(git worktree:*)",
      "Bash(git push -u origin wersja-1-0-1-r2:*)",
      "Agent",
      "SendMessage",
      "mcp__claude-code-remote__send_message",
      "mcp__claude-code-remote__send_later"
    ],
    "deny": [
      "Bash(git push origin main:*)",
      "Bash(git push -u origin main:*)",
      "Bash(git push --force:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/CLAUDE.md\"; [ -f \"$f\" ] && { echo 'Aktualne zasady projektu (CLAUDE.md z dysku, po streszczeniu kontekstu — mają pierwszeństwo przed wcześniejszą kopią):'; cat \"$f\"; } || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
