              "type": "number",
              "minimum": -60,
              "maximum": 60
             },
             "minItems": 3,
             "maxItems": 3,
             "description": "Zmiana położenia chwytu [dx, dy, dz] w cm."
            }
           },
           "required": [],
           "additionalProperties": false
          },
          "L": {
           "type": "object",
           "properties": {
            "chwyt": {
             "type": "array",
             "items": {
              "type": "number",
              "minimum": -60,
              "maximum": 60
             },
             "minItems": 3,
             "maxItems": 3,
             "description": "Zmiana położenia chwytu [dx, dy, dz] w cm."
            }
           },
           "required": [],
           "additionalProperties": false
          }
         },
         "required": [],
         "additionalProperties": false,
         "description": "R = prawa strona osoby, L = lewa."
        }
       },
       "required": [
        "u"
       ],
       "additionalProperties": false
      },
      "minItems": 2,
      "maxItems": 8,
      "description": "Delty dodawane do pozy poprawnej."
     }
    },
    "required": [
     "cue",
     "znacznik",
     "dotyczy",
     "klatki"
    ],
    "additionalProperties": false,
    "description": "Błąd = modyfikacja pozy poprawnej (delty), nie osobna poza."
