{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "jest",
  "jest": {
    "projectType": "custom",
    "configFile": "jest.mutation.config.js",
    "enableFindRelatedTests": true
  },
  "mutate": [
    "lib/units.ts",
    "lib/stats.ts"
  ],
  "coverageAnalysis": "perTest",
  "concurrency": 2,
  "timeoutMS": 5000,
  "reporters": [
    "json",
    "progress-append-only"
  ],
  "jsonReporter": {
    "fileName": ".stryker-tmp/report.json"
  },
  "tempDirName": ".stryker-tmp",
  "ignorePatterns": [
    "node_modules",
    ".expo",
    "ios",
    "dist"
  ],
  "maxTestRunnerReuse": 40,
  "testRunnerNodeArgs": [
    "--max-old-space-size=3000"
  ],
  "incremental": false,
  "mutator": {
    "excludedMutations": [
      "StringLiteral"
    ]
  }
}