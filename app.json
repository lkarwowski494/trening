{
  "expo": {
    "name": "Trening",
    "slug": "trening",
    "version": "0.9.0",
    "scheme": "trening",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "pl.lukasz.trening",
      "appleTeamId": "8NQ9GHY8GF",
      "supportsTablet": false,
      "infoPlist": {
        "NSSupportsLiveActivities": true,
        "CFBundleLocalizations": [
          "pl",
          "en",
          "cs",
          "sk",
          "hu",
          "ro",
          "bg",
          "hr",
          "sl",
          "sr",
          "lt",
          "lv",
          "et",
          "uk",
          "es",
          "pt"
        ],
        "CFBundleAllowMixedLocalizations": true,
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true,
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "pl.lukasz.trening",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#F2F0EB"
      }
    },
    "plugins": [
      "./plugins/withoutPushEntitlement",
      "expo-router",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "color": "#E8590C"
        }
      ],
      "expo-asset",
      "expo-font",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Trening nie odczytuje danych zdrowotnych — iOS wymaga tego opisu przy uprawnieniu HealthKit.",
          "NSHealthUpdateUsageDescription": "Trening zapisuje zakończone treningi siłowe do Apple Health.",
          "background": false
        }
      ],
      "@bacons/apple-targets",
      "expo-localization",
      "expo-sharing",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "backgroundColor": "#F2F0EB",
          "resizeMode": "contain",
          "imageWidth": 200,
          "ios": {
            "enableFullScreenImage_legacy": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "locales": {
      "pl": "./locales/pl.json",
      "en": "./locales/en.json",
      "cs": "./locales/cs.json",
      "sk": "./locales/sk.json",
      "hu": "./locales/hu.json",
      "ro": "./locales/ro.json",
      "bg": "./locales/bg.json",
      "hr": "./locales/hr.json",
      "sl": "./locales/sl.json",
      "sr": "./locales/sr.json",
      "lt": "./locales/lt.json",
      "lv": "./locales/lv.json",
      "et": "./locales/et.json",
      "uk": "./locales/uk.json",
      "es": "./locales/es.json",
      "pt": "./locales/pt.json"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "extra": {
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "RestWidget",
                  "bundleIdentifier": "pl.lukasz.trening.restwidget",
                  "entitlements": {}
                }
              ]
            }
          }
        }
      }
    }
  }
}
