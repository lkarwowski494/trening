#!/usr/bin/expect -f
# Jednorazowe założenie podpisu dla instalacji „ad hoc” (certyfikat dystrybucyjny + profile dla aplikacji i widżetu).
# `eas build --non-interactive` nie umie utworzyć certyfikatu, a `eas credentials:configure-build` jest tylko interaktywne —
# tu odpowiada za użytkownika: urządzenia — zaznaczone domyślnie (Enter), a na pozostałe pytania — odpowiedź domyślna.
# Wybór urządzeń (Q-023; eas-cli 24.8.0 DeviceUtils.chooseDevicesAsync = multiselect z pakietu prompts 2.4.2, min 1; pytanie pada
# osobno dla aplikacji i dla widżetu):
#  - bez profilu wszystkie zarejestrowane urządzenia są zaznaczone od razu → sam Enter (dawne „a” je ODZNACZAŁO — „a” przełącza wszystkie
#    na odwrotność pozycji pod kursorem — wybór udawał się dopiero po błędzie „minimum 1”, a przerysowania z tym samym pytaniem
#    wysyłały kolejne „a” i Enter, także do następnych pytań);
#  - z istniejącym profilem zaznaczone są urządzenia z profilu → Enter je zostawia (nowe urządzenia dokłada akcja build:
#    --refresh-ad-hoc-provisioning-profile bierze wszystkie zarejestrowane);
#  - nic nie zaznaczone → Enter daje błąd „You must select a minimum of 1 choices.” → wtedy samo „a” (zaznacza wszystkie); przerysowany
#    prompt dostaje Enter z reguły niżej.
# Enter tylko na aktywny prompt (pytanie + podpowiedź „Space to select” w tej samej linii) — ekran po wyborze (✔, bez podpowiedzi)
# niczego nie wysyła. Symulacja na prawdziwym prompts 2.4.2: tests/eas-capabilities.test.ts (Q-023).
# Klucz ASC i zespół Apple przychodzą ze zmiennych środowiskowych (tryb klucza API, bez logowania Apple ID).
set timeout 300
log_user 1
spawn npx --yes eas-cli@$env(EAS_CLI) credentials:configure-build -p ios -e adhoc
expect {
  -re {You must select a minimum of} { sleep 1; send "a"; exp_continue }
  -re {Select devices for the ad hoc build:[^\n]*Space to select} { sleep 1; send "\r"; exp_continue }
  -re {register them now\?} { puts "\n::error::Brak zarejestrowanych urządzeń — najpierw akcja zarejestruj-iphone."; exit 2 }
  -re {Select certificates to revoke} { puts "\n::error::Limit certyfikatów Apple — usuń stary certyfikat w developer.apple.com."; exit 3 }
  -re {›[^\n]*\(Y/n\)} { sleep 1; send "\r"; exp_continue }
  -re {›[^\n]*\(y/N\)} { sleep 1; send "\r"; exp_continue }
  -re {› - Use arrow-keys} { sleep 1; send "\r"; exp_continue }
  timeout { puts "\n::error::Brak odpowiedzi przez 300 s — nieznane pytanie eas-cli (patrz log wyżej)."; exit 4 }
  eof
}
catch wait result
exit [lindex $result 3]
