#!/bin/sh
# Hak pre-push (L-009, decyzja właściciela 21.10.2026): zatrzymuje wypchnięcie, gdy lint nie przechodzi albo któryś plik pochodny (README, macierz testów, konteksty, zegarek…) jest nieaktualny.
# Dwa sprawdzenia, w tej kolejności, przerwanie przy pierwszym błędzie: lint, check:pochodne (README, macierz, konteksty, pliki pochodne, strażniki tekstowe); do tego (L-037) przy zmianach w docs/: numeracja lekcji i testy dokumentów.
# Wyjątek: gdy zmiany względem origin/main (albo — H1, 31.10.2026 — od najbliższego commitu z pełnym verify) to wyłącznie dokumenty (scripts/verify-docs.mjs --czy-dokumenty), lint jest pomijany.
# Pełne `npm run verify` jest obowiązkiem przed wypchnięciem (CLAUDE.md), a od L-049 (opcja A, decyzja właściciela 28.10.2026) pierwszy krok haka to sprawdza:
# drzewo wypychanego commitu musi mieć znacznik zielonego verify (scripts/verify-znacznik.mjs; commit tylko z dokumentami — znacznik verify:docs, także po pełnym verify wcześniejszego kodu — H1, 31.10.2026). Ok. 0,1 s.
# Instaluje go `npm ci` (skrypt `prepare` → scripts/hooks/instaluj.mjs ustawia core.hooksPath na scripts/hooks; nie w CI i nie w katalogu bez .git).
# Czas (pomiar 28.10.2026, 4 rdzenie, maszyna współdzielona): lint ok. 25 s + check:pochodne ok. 55 s (kroki równolegle, jest --maxWorkers=1); ok. 35 s przed decyzją 8a.
# Obejście — tylko świadomie (np. wypychasz gałąź roboczą, której i tak nie scalasz): git push --no-verify
# Usunięcie gałęzi (git push --delete) hak przepuszcza bez sprawdzeń.
# POSIX sh, bez składni bash.

# Bez terminala na wejściu git podaje linie „lokalny_ref lokalny_sha zdalny_ref zdalny_sha”; same zera = usuwanie gałęzi lub tagu.
# Zapamiętujemy je („lokalny_sha zdalny_ref zdalny_sha”), żeby po trzech sprawdzeniach ocenić, czy wypychane commity zmieniają docs/ (L-037, wariant A).
refy=""
if [ ! -t 0 ]; then
  tylko_usuwanie=1
  while read -r _ lokalny_sha zdalny_ref zdalny_sha; do
    case "$lokalny_sha" in
      '' | *[!0]*) tylko_usuwanie=0; refy="$refy$lokalny_sha $zdalny_ref $zdalny_sha
" ;;
    esac
  done
  if [ "$tylko_usuwanie" = 1 ]; then
    exit 0
  fi
fi

cd "$(git rev-parse --show-toplevel)" || exit 1
start=$(date +%s)

# L-049 (opcja A, 28.10.2026): znacznik zielonego verify dla każdego wypychanego commitu (bez danych wejściowych — HEAD).
[ -n "$refy" ] || refy="$(git rev-parse HEAD) - -
"
bez_znacznika=$(printf '%s' "$refy" | while read -r lokalny_sha _ _; do
  [ -n "$lokalny_sha" ] || continue
  node scripts/verify-znacznik.mjs --sprawdz "$lokalny_sha" >&2 || echo "$lokalny_sha"
done)
if [ -n "$bez_znacznika" ]; then
  echo "" >&2
  echo "hak pre-push: WYPCHNIĘCIE ZATRZYMANE — brak zielonego pełnego verify dla wypychanego stanu plików (L-049, decyzja właściciela 28.10.2026)." >&2
  echo "Jak naprawić: zatwierdź wszystkie zmiany i uruchom npm run verify (commit tylko z dokumentami: npm run verify:docs), potem wypchnij ponownie. Obejście (świadome): git push --no-verify" >&2
  exit 1
fi

sprawdz() {
  echo "hak pre-push: npm run $1" >&2
  if ! npm run "$1" >&2; then
    echo "" >&2
    echo "hak pre-push: WYPCHNIĘCIE ZATRZYMANE — npm run $1 zwróciło błąd." >&2
    echo "Jak naprawić: $2" >&2
    echo "Potem dodaj zmiany do commitu i wypchnij ponownie. Obejście (świadome): git push --no-verify" >&2
    exit 1
  fi
}

if node scripts/verify-docs.mjs --czy-dokumenty > /dev/null 2>&1; then
  echo "hak pre-push: zmiany tylko w dokumentach (verify:docs) — pomijam lint" >&2
else
  sprawdz lint "popraw błędy zgłoszone przez eslint i dodaj poprawki do commitu."
fi
# check:pochodne (decyzja właściciela 8a, 28.10.2026): wszystkie generatory w trybie --check (README, macierz, konteksty tłumaczeń, wskazówki, figury, sprzęt, przepływy,
# wektory BRD), pliki zegarka/widżetu/_source.json i szybkie strażniki czytające źródła jako tekst — scripts/pochodne.mjs (zastępuje osobne check:readme, i18n-context, check:matrix).
sprawdz check:pochodne "przeczytaj, który krok padł — każdy podaje własne polecenie naprawy (zwykle odpowiedni generator z --write albo UPDATE_*=1 z odpowiednim testem), potem git add odświeżonych plików."

# L-037 (wariant A, decyzja właściciela 26.10.2026): gdy wypychane commity zmieniają docs/, sprawdzamy numerację lekcji i testy dokumentów — zmiana „tylko w dokumentach”
# pomijała lint, więc czerwone CI łapało dopiero numerację docs/40. Reguła gałęzi: na main i integracja-* nienumerowana lekcja (## L-NNN) to błąd, na gałęziach funkcji jest
# dozwolona (numer nadaje koordynator przy scalaniu: scripts/numeruj-lekcje.mjs). Testy dostają GITHUB_REF_NAME = gałąź docelowa, tak jak w CI (tests.yml).
docs_zmienione() { # $1 = lokalny sha, $2 = zdalny sha (same zera = nowa gałąź: porównanie z origin/main); nieznany lokalny sha — nic do sprawdzenia
  git cat-file -e "$1^{commit}" 2>/dev/null || return 1
  case "$2" in *[!0]*) baza="$2" ;; *) baza=$(git merge-base origin/main "$1" 2>/dev/null) ;; esac
  if [ -z "$baza" ] || ! git cat-file -e "$baza^{commit}" 2>/dev/null; then # brak punktu odniesienia (np. pierwsze wypchnięcie): liczą się wszystkie pliki commitu
    git ls-tree -r --name-only "$1" 2>/dev/null | grep -q '^docs/'
    return
  fi
  git diff --name-only "$baza..$1" 2>/dev/null | grep -q '^docs/'
}
sprawdz_docs() { # $1 = gałąź docelowa
  echo "hak pre-push: zmiany w docs/ — numeracja lekcji i testy dokumentów (gałąź $1)" >&2
  case "$1" in
    main | integracja-*)
      if ! node scripts/numeruj-lekcje.mjs --sprawdz >&2 </dev/null; then
        echo "" >&2
        echo "hak pre-push: WYPCHNIĘCIE ZATRZYMANE — na gałęzi $1 lekcje w docs/40 muszą mieć numer." >&2
        echo "Jak naprawić: node scripts/numeruj-lekcje.mjs (nadaje kolejne numery), potem git add docs/40-lekcje.md i commit. Obejście (świadome): git push --no-verify" >&2
        exit 1
      fi ;;
  esac
  if ! GITHUB_REF_NAME="$1" npx jest tests/audit-m1-p4b-queue.test.ts tests/verify-docs.test.ts >&2 </dev/null; then
    echo "" >&2
    echo "hak pre-push: WYPCHNIĘCIE ZATRZYMANE — testy dokumentów (numeracja lekcji, verify:docs) zwróciły błąd." >&2
    echo "Jak naprawić: przeczytaj, który test padł (zwykle docs/40: numeracja lekcji, kolejność, rejestr ryzyk), popraw dokument i dodaj do commitu. Obejście (świadome): git push --no-verify" >&2
    exit 1
  fi
}
printf '%s' "$refy" | while read -r lokalny_sha zdalny_ref zdalny_sha; do
  [ -n "$lokalny_sha" ] || continue
  if docs_zmienione "$lokalny_sha" "$zdalny_sha"; then
    printf '%s\n' "${zdalny_ref#refs/heads/}"
  fi
done | sort -u | while read -r galaz; do sprawdz_docs "$galaz" || exit 1; done || exit 1

echo "hak pre-push: zielone po $(($(date +%s) - start)) s" >&2
exit 0
